		{
			"name": "2. Authentication",
			"item": [
				{
					"name": "Register",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if(pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    // Handle both verification enabled and disabled responses",
									"    if (jsonData.data.token) {",
									"        // Verification disabled - token returned directly",
									"        pm.collectionVariables.set('token', jsonData.data.token);",
									"        pm.collectionVariables.set('userId', jsonData.data.user.id);",
									"        console.log('Token and UserID saved (auto-login).');",
									"    } else {",
									"        // Verification enabled - only userId returned",
									"        pm.collectionVariables.set('userId', jsonData.data.userId);",
									"        console.log('UserID saved. Email verification required.');",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"test-user@example.com\",\n    \"password\": \"SecurePass123!\",\n    \"firstName\": \"Test\",\n    \"lastName\": \"User\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/v1/auth/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"v1",
								"auth",
								"register"
							]
						},
						"description": "Registers a new user."
					},
					"response": []
				},
